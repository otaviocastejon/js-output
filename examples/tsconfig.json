{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "outDir": "./nest-app/dist",
    "rootDir": "./nest-app",
    "declaration": false,
    "sourceMap": true
  },
  "include": ["nest-app/main.ts"]
}
